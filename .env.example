# ⚠️  TEMPLATE ONLY — this file is committed to a public repo.
#     Copy it to .env (git-ignored) and put your real keys THERE, never here.
#     On Vercel, set the same names under Project → Settings → Environment Variables.

# --- Nebius Token Factory (OpenAI-compatible) -----------------------------
# Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# NVIDIA Nemotron models. Rafiki routes each step to the right size model.
# If an id is wrong, Rafiki auto-resolves it against GET /v1/models at boot.
MODEL_FAST=nvidia/nvidia-nemotron-3-nano-30b-a3b      # planner, follow-ups (fast + cheap)
MODEL_SMART=nvidia/nemotron-3-super-120b-a12b         # answer synthesis
MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b          # "Deep Dive" mode reasoning

# --- Tavily search ---------------------------------------------------------
# Get a key at https://app.tavily.com
TAVILY_API_KEY=

# --- Server ----------------------------------------------------------------
PORT=8787
# Set to 1 to run with canned data (no keys needed) — handy for UI work.
RAFIKI_MOCK=0

# --- Supabase (optional) ---------------------------------------------------
# Cloud save, anti-cheat scoring and the global leaderboard. Without these the
# game runs fully local (progress lives in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
